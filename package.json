{
  "name": "table-charts",
  "version": "0.0.1",
  "description": "A web components that converts HTML tables into accessible charts",
  "type": "module",
  "main": "./dist/table-bar-chart.js",
  "exports": {
    ".": {
      "types": "./dist/table-bar-chart.d.ts",
      "import": "./dist/table-bar-chart.js"
    },
    "./table-bar-chart": {
      "types": "./dist/table-bar-chart.d.ts",
      "import": "./dist/table-bar-chart.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "web-component",
    "custom-element",
    "chart",
    "bar-chart",
    "data-visualization",
    "accessible",
    "a11y"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poetro/table-charts.git"
  },
  "bugs": {
    "url": "https://github.com/poetro/table-charts/issues"
  },
  "homepage": "https://poetro.github.io/table-charts/",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "echo 'Build script not configured'",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "serve": "http-server . -p 8080",
    "dev": "http-server . -p 5173"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "http-server": "^14.1.1"
  }
}
